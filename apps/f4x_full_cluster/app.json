{
  "id": "f4x_full_cluster",
  "title": "Full Cluster Map",
  "version": "0.1.0",
  "startType": "autostart",
  "vendor": "custom",
  "loggingId": "OF4M",
  "iconGlyph": "gauge",
  "description": "The Waze map over the whole instrument cluster, with the speed and engine speed drawn over it. Needs Waze on cluster with its Full cluster mode. The stock gauges come back by themselves when this app stops or has no speed from the car.",
